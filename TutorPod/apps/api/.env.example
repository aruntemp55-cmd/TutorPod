PORT=4010
DATABASE_URL=postgres://USER@localhost:5432/tutorpod
JWT_SECRET=change-me
OTP_STUB_CODE=000000
NODE_ENV=development
SAMPLE_AUDIO_URL=https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3
PUBLIC_BASE_URL=http://localhost:4010
POD_GENERATE_DELAY_MS=350

# --- OpenAI (optional — leave unset to use stubs) ---
# Never commit real keys. Copy to apps/api/.env locally.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
# Host voices (comma-separated): host1,host2,host3,host4
OPENAI_TTS_VOICES=alloy,nova,echo,onyx

# --- Quotas / rate limits (T076) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PODS=10
RATE_LIMIT_MAX_QUESTIONS=30
POD_DAILY_QUOTA=20

# --- Deep links / share (T071) ---
DEEP_LINK_BASE=https://tutorpod.app

# --- Optional S3-compatible storage (T077) — unset = local apps/api/storage ---
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# e.g. http://localhost:9000 for MinIO
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true
